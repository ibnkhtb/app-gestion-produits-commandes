// Déclaration des entités
entity Categorie{
    @Id
    idCategorie Long required,
    nomCategorie String required
}
entity Produit{
    @Id
    idProduit Long required,
    nomProduit String required ,
    descriptionProduit String required ,
    prixProduit Double required,
    imageProduit String required
} 
entity Client {
    @Id
    idClient Long required,
    nom String required,
    prenom String required ,
    adresse String required,
    telephone  String required,
    email String required
}

entity Commande {
    @Id
    idCommande Long required,
    dateCommande String required 
}

// Relations
relationship ManyToOne {
    Produit{categorie} to Categorie
}

relationship OneToOne {
    Client{user} to User with builtInEntity
}

relationship ManyToOne {
    Commande{client} to Client
}

relationship ManyToOne {
    Commande{produit} to Produit
}



paginate * with pagination
dto * with mapstruct
service all with serviceClass
filter *
